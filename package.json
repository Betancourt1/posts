    "author": "node tools/author_dev.mjs",
    "author:api": "node tools/author_server.mjs",
    "new:post": "node tools/new_content.mjs post",
    "new:zettel": "node tools/new_content.mjs zettel",
    "new:page": "node tools/new_content.mjs page",
    "build": "hugo --gc --minify && node tools/clean_pagefind_output.mjs && pagefind --site public",
    "build:local": "npm run build && node tools/sync_pagefind_static.mjs"
  },
  "devDependencies": {
    "hugo-extended": "^0.163.3",
    "pagefind": "1.5.2"
  }
