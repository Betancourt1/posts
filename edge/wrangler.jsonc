{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "posts-edge-preview",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-07-13",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "posts-edge-preview",
      "database_id": "7e64c8f5-b3f4-4735-91b3-01e43c17b2e3",
      "migrations_dir": "db/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "posts-edge-preview-media"
    }
  ],
  "vars": {
    "CONTENT_PROJECTOR_VERSION": "1",
    "GITHUB_OWNER": "Betancourt1",
    "GITHUB_REPO": "posts",
    "GITHUB_BRANCH": "main",
    "PUBLIC_SITE_ORIGIN": "https://fbetancourt.work",
    "AUTHOR_MODE": "false"
  }
}
