{
  "name": "posts-edge",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "WRANGLER_LOG=none ASTRO_TELEMETRY_DISABLED=1 astro dev --host 127.0.0.1 --port 4321",
    "types": "WRANGLER_LOG=none wrangler types",
    "build": "npm run types && WRANGLER_LOG=none ASTRO_TELEMETRY_DISABLED=1 astro check && WRANGLER_LOG=none ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "WRANGLER_LOG=none ASTRO_TELEMETRY_DISABLED=1 astro preview --host 127.0.0.1 --port 4321",
    "db:migrate:local": "WRANGLER_LOG=none wrangler d1 migrations apply DB --local"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.1.3",
    "astro": "7.0.9",
    "marked": "18.0.6",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "typescript": "6.0.3",
    "wrangler": "4.110.0"
  }
}
