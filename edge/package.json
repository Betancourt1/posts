{
  "name": "posts-edge",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:public": "node scripts/prepare-public.mjs",
    "predev": "npm run prepare:public",
    "dev": "WRANGLER_LOG=none ASTRO_TELEMETRY_DISABLED=1 astro dev --host 127.0.0.1 --port 4321",
    "types": "WRANGLER_LOG=none wrangler types",
    "prebuild": "npm run prepare:public",
    "build": "npm run types && WRANGLER_LOG=none ASTRO_TELEMETRY_DISABLED=1 astro check && WRANGLER_LOG=none ASTRO_TELEMETRY_DISABLED=1 astro build",
    "deploy": "npm run build && wrangler deploy",
    "deploy:dry-run": "npm run build && wrangler deploy --dry-run",
    "prepreview": "npm run prepare:public",
    "preview": "WRANGLER_LOG=none ASTRO_TELEMETRY_DISABLED=1 astro preview --host 127.0.0.1 --port 4321",
    "test": "node --test",
    "db:migrate:local": "WRANGLER_LOG=none wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:seed:sql": "node scripts/build-seed-sql.mjs",
    "db:seed:local": "npm run db:migrate:local && npm run db:seed:sql && WRANGLER_LOG=none wrangler d1 execute DB --local --file .generated/seed.sql",
    "db:seed:remote": "npm run db:migrate:remote && npm run db:seed:sql && wrangler d1 execute DB --remote --file .generated/seed.sql",
    "media:sync": "node scripts/sync-media.mjs",
    "media:sync:local": "node scripts/sync-media.mjs --local",
    "media:sync:dry-run": "node scripts/sync-media.mjs --dry-run",
    "quotes:normalize": "node scripts/normalize-quote-metadata.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.1.3",
    "astro": "7.0.9",
    "marked": "18.0.6",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "miniflare": "4.20260708.1",
    "typescript": "6.0.3",
    "wrangler": "4.110.0"
  }
}
