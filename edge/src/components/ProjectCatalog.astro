---
import { validProjectLink } from "../../../functions/_lib/project-links.js";
import type { Language } from "./types";

interface Props {
  lang: Language;
  title: string;
  description?: string;
  projects: any[];
  authorMode: boolean;
  notebook: string;
}
const { lang, title, description, authorMode, notebook, projects } = Astro.props;
const es = lang === "es";
const entries = projects.toSorted((a, b) => Number(b.frontMatter.featured === true) - Number(a.frontMatter.featured === true));
---
<header class="page-header">
  <h1>{title}</h1>
  {description && <p class="lead">{description}</p>}
  {authorMode && <div class="project-actions"><button type="button" class="project-control" data-author-action="add-post" data-notebook={notebook}>{es ? "Nuevo proyecto" : "New project"}</button>
    <button type="button" class="project-control" data-author-action="edit-notebook" data-source-path={notebook + "/_index.md"}>{es ? "Editar catálogo" : "Edit catalog"}</button></div>}
</header>
<section class="project-catalog" aria-label={title}>
  {entries.map((project) => {
    const href = (authorMode ? "/admin" : "") + project.path;
    const first = project.frontMatter.project_links?.find(validProjectLink);
    return (
      <article>
        <div class="project-status">
          {project.frontMatter.featured === true && <span>{es ? "Destacado" : "Featured"}</span>}
          {authorMode && <span>{project.draft || project.hidden ? (es ? "Borrador" : "Draft") : (es ? "Publicado" : "Published")}</span>}
        </div>
        <h2><a href={href}>{project.title}</a></h2>
        <p>{project.summary}</p>
        <div class="project-actions">
          {first && <a href={first.href}>{first.label} ↗</a>}
          <a href={href}>{es ? "Ver proyecto" : "View project"} →</a>
          {authorMode && <button type="button" class="project-control" data-author-action="edit-post" data-source-path={project.sourcePath}>{es ? "Editar" : "Edit"}</button>}
        </div>
      </article>
    );
  })}
</section>
