---

const strings = {
  title: "CV links",
  intro: "Create one link per CV and assign it to a vacancy to see the visits it receives.",
  vacancy: "Vacancy (optional)",
  private: "Only visible in admin. Up to 200 characters.",
  unnamed: "No vacancy assigned",
  id: "CV ID (optional)",
  hint: "Leave blank to generate a random ID. Links never expire.",
  register: "Register ID",
  working: "Registering…",
  registered: "ID registered. You can now copy the link for your CV.",
  existing: "This ID was already registered. Its vacancy and status were preserved.",
  heading: "Registered IDs",
  empty: "No IDs registered yet.",
  loading: "Loading…",
  active: "Active",
  disabled: "Disabled",
  neverExpires: "Never expires",
  link: "CV link",
  visits: "Visits",
  latest: "Latest visit",
  noVisits: "No recorded visits",
  copy: "Copy link",
  copied: "Link copied.",
  copyFailed: "Select the link and copy it manually.",
  unavailable: "Could not access the registry. Check your admin session and try again.",
  invalid: "Use 16–64 letters, digits, hyphens, or underscores.",
  invalidVacancy: "The vacancy must be at most 200 characters.",
};
---

<section class="cv-links" data-cv-links data-site-origin={Astro.site?.origin || Astro.url.origin} data-strings={JSON.stringify(strings)}>
  <header class="page-header">
    <h1>{strings.title}</h1>
    <p class="lead">{strings.intro}</p>
  </header>
  <form class="cv-links-form" data-cv-form>
    <label for="cv-vacancy">{strings.vacancy}</label>
    <input id="cv-vacancy" name="vacancy" type="text" maxlength="200" autocomplete="off" aria-describedby="cv-vacancy-hint" />
    <p id="cv-vacancy-hint">{strings.private}</p>
    <label for="cv-id">{strings.id}</label>
    <input id="cv-id" name="cv_id" type="text" minlength="16" maxlength="64" pattern="[A-Za-z0-9_\-]{16,64}" autocomplete="off" spellcheck="false" aria-describedby="cv-id-hint" />
    <p id="cv-id-hint">{strings.hint}</p>
    <button type="submit">{strings.register}</button>
  </form>
  <p class="cv-links-status" data-cv-status role="status" aria-live="polite"></p>
  <h2>{strings.heading}</h2>
  <p data-cv-empty>{strings.loading}</p>
  <ul class="cv-links-list" data-cv-list></ul>
  <template data-cv-row>
    <li class="cv-links-card">
      <h3 data-cv-vacancy></h3>
      <code data-cv-id></code>
      <p class="cv-links-meta"><span data-cv-state></span> · {strings.neverExpires}</p>
      <p><strong>{strings.visits}: <span data-cv-visits></span></strong><br />{strings.latest}: <span data-cv-latest></span></p>
      <div class="cv-links-copy">
        <label><span>{strings.link}</span><input type="text" readonly data-cv-url /></label>
        <button type="button" data-cv-copy>{strings.copy}</button>
      </div>
    </li>
  </template>
</section>
<script is:inline src="/js/cv-links.js" defer></script>
