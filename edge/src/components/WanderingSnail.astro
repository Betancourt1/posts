---
import type { Language } from "./types";
const { lang } = Astro.props as { lang: Language };
---

<div class="snail-path">
  <button class="wandering-snail" type="button" aria-label={lang === "es" ? "Añadir otro caracol" : "Add another snail"} title={lang === "es" ? "Añadir otro caracol" : "Add another snail"}>
    <svg class="snail-sprite" viewBox="0 0 32 24" aria-hidden="true" shape-rendering="crispEdges">
      <g class="snail-body">
        <path fill="var(--snail-outline)" d="M24 1h3v6h-3zm5 0h3v6h-3zM25 6h2v4h-2zm4 0h2v4h-2zM23 8h6v1h2v1h1v7h-1v2h-2v2H3v-1H1v-2h3v-2h3v-2h14v-3h2z"/>
        <path fill="var(--snail-body)" d="M25 2h1v3h-1zm5 0h1v3h-1zM24 9h5v1h2v7h-1v2h-2v1H3v-1h2v-2h3v-2h14v-3h2z"/>
        <path fill="var(--snail-outline)" d="M25 11h1v3h-1zm4 0h1v3h-1zm-3 5h3v1h-3z"/>
        <path fill="var(--snail-cheek)" d="M23 15h1v2h-1z"/>
      </g>
      <g class="snail-shell">
        <path fill="var(--snail-outline)" d="M7 4h11v1h3v2h2v3h1v5h-1v3h-2v2H7v-1H4v-2H2v-3H1v-4h1V7h2V5h3z"/>
        <path fill="var(--snail-shell)" d="M7 5h11v1h3v2h1v2h1v5h-1v3h-2v1H7v-1H5v-2H3v-3H2v-3h1V8h2V6h2z"/>
        <path fill="var(--snail-highlight)" d="M7 6h11v1H7zM5 7h2v1H5zM4 8h1v3H4z"/>
        <path fill="var(--snail-spiral)" d="M8 8h9v1h2v2h1v4h-1v2h-2v1h-6v-1H9v-1H8v-2h1v-3h2v-1h5v1h1v2h-1v1h-3v-1h1v-1h-2v1h-1v2h1v1h5v-1h1v-4h-1v-1h-2V9H8z"/>
        <g class="snail-moss" fill="var(--snail-highlight)"><path d="M5 4h2V3h2v2H5zm5 0V2h2v1h2v2h-4zm6 0V3h2v1h2v2h-4z"/></g>
        <g class="snail-star" fill="#ffe6a8"><path d="M15 5h2v2h2v2h-2v2h-2V9h-2V7h2zM8 7h1v1H8z"/></g>
      </g>
      <g class="snail-foot" fill="var(--snail-outline)"><path d="M5 21h3v1H5zm7 0h3v1h-3zm7 0h3v1h-3zm7 0h2v1h-2z"/></g>
    </svg>
  </button>
</div>
<script is:inline src="/js/wandering-snail.js" defer></script>
