---
import TagList from "./TagList.astro";
import { displayDate } from "./_utils";
import type {
  BacklinkItem,
  Language,
  PhotoImage,
  TagItem,
} from "./types";

interface Props {
  title: string;
  date?: string | Date | null;
  section?: string;
  summary?: string | null;
  tags?: TagItem[];
  bodyHtml: string;
  bodyMarkdown?: string;
  sourcePath?: string | null;
  slug?: string | null;
  permalink?: string;
  image?: string | null;
  imageAlt?: string | null;
  caption?: string | null;
  images?: PhotoImage[];
  titleInBody?: boolean;
  authorMode?: boolean;
  lang?: Language;
  backlinks?: BacklinkItem[];
}

const {
  title,
  date = null,
  section = "",
  summary = null,
  tags = [],
  bodyHtml,
  bodyMarkdown = "",
  sourcePath = null,
  slug = null,
  permalink = Astro.url.pathname,
  image = null,
  imageAlt = title,
  caption = null,
  images = [],
  titleInBody = false,
  authorMode = false,
  lang = "en",
  backlinks = [],
} = Astro.props;
const dateLabel = displayDate(date);
const isPhoto = images.length > 0 || section === "fotografia";
const wordCount = bodyMarkdown.trim() ? bodyMarkdown.trim().split(/\s+/).length : 0;
const readingTime = Math.max(1, Math.ceil(wordCount / 220));
const hasSidenotes = bodyHtml.includes('class="sidenote-endnotes"');
const metadata = [
  sourcePath ? `file:         ${sourcePath}` : null,
  `title:        ${title}`,
  dateLabel ? `date:         ${dateLabel}` : null,
  `section:      ${section}`,
  slug ? `slug:         ${slug}` : null,
  tags.length ? `tags:         [${tags.map((tag) => tag.label).join(", ")}]` : null,
  `wordcount:    ${wordCount}`,
  `reading_time: ${readingTime}min`,
  `permalink:    ${permalink}`,
  summary ? `summary:      ${summary}` : null,
].filter(Boolean).join("\n");
const rawSource = [
  "---",
  `title: ${title}`,
  dateLabel ? `date: ${dateLabel}` : null,
  tags.length ? `tags: [${tags.map((tag) => tag.label).join(", ")}]` : null,
  summary ? `summary: ${summary}` : null,
  "---",
  "",
  bodyMarkdown,
].filter((line) => line !== null).join("\n");
---

<article
  class:list={["post", { "photo-post": isPhoto, "post--has-sidenotes": hasSidenotes }]}
>
  <header class="post-header">
    <div class="post-header-top" style="display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; margin-bottom: 8px;">
      <div class="post-card-meta">{dateLabel}</div>
      {(authorMode || !isPhoto) && <div class="post-header-actions">
        {authorMode && sourcePath && (
          <>
            <button type="button" class="author-action-button" data-author-action="edit-post" data-source-path={sourcePath} aria-label={lang === "es" ? "Editar página" : "Edit page"} title={lang === "es" ? "Editar página" : "Edit page"}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"></path><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4Z"></path></svg>
            </button>
            <button type="button" class="author-action-button author-action-button--danger" data-author-action="delete-post" data-source-path={sourcePath} aria-label={lang === "es" ? "Eliminar página" : "Delete page"} title={lang === "es" ? "Eliminar página" : "Delete page"}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18"></path><path d="M8 6V4h8v2"></path><path d="M19 6l-1 15H6L5 6"></path></svg>
            </button>
          </>
        )}
        {!isPhoto && (
          <>
            {hasSidenotes && (
              <button type="button" class="post-context-button" data-sidenote-graph-open aria-label={lang === "es" ? "Abrir grafo" : "Open graph"} title={lang === "es" ? "Abrir grafo" : "Open graph"}>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="5" cy="12" r="2"></circle><circle cx="12" cy="5" r="2"></circle><circle cx="19" cy="12" r="2"></circle><path d="m6.5 10.5 4-4"></path><path d="m13.5 6.5 4 4"></path><path d="M7 12h10"></path></svg>
              </button>
            )}
            <button type="button" class="zen-toggle-btn" id="zen-toggle-btn" aria-label={lang === "es" ? "Modo lectura Zen" : "Zen reading mode"} title={lang === "es" ? "Modo lectura Zen" : "Zen reading mode"}>
              <svg class="zen-icon-normal" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
              <svg class="zen-icon-active" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"></path><line x1="1" y1="1" x2="23" y2="23"></line></svg>
            </button>
          </>
        )}
      </div>}
    </div>

    {!titleInBody && <h1 class="post-title" style="margin-top: 0; margin-bottom: 12px;">{title}</h1>}
    <TagList tags={tags} lang={lang} />
    {section !== "lit" && summary && <p class="lead post-summary" style="margin-top: 8px;">{summary}</p>}
  </header>

  {images.length > 0 ? (
    <div class="photo-post-gallery" aria-label={lang === "es" ? "Galería de imágenes" : "Image gallery"}>
      {images.map((item, index) => (
        <figure class="photo-post-figure">
          <img src={item.src} alt={item.alt || title} decoding="async" loading={index === 0 ? undefined : "lazy"} fetchpriority={index === 0 ? "high" : undefined} />
          {item.caption && <figcaption>{item.caption}</figcaption>}
        </figure>
      ))}
    </div>
  ) : image ? (
    <figure class={isPhoto ? "photo-post-figure" : "post-featured-image"}>
      <img src={image} alt={imageAlt || title} decoding="async" fetchpriority="high" />
      {caption && <figcaption>{caption}</figcaption>}
    </figure>
  ) : null}

  {bodyHtml && <div class:list={["post-body", { "photo-post-body": isPhoto }]} set:html={bodyHtml}></div>}

  <div class="infra-raw-block">
    <div class="infra-metadata">
      <h3 class="infra-section-label">// metadata</h3>
      <pre class="infra-meta-raw">{metadata}</pre>
    </div>
    <div class="infra-raw-source">
      <h3 class="infra-section-label">// raw source</h3>
      <pre class="infra-raw-content"><code>{rawSource}</code></pre>
    </div>
  </div>

  {backlinks.length > 0 && (
    <section class="backlinks-section">
      <hr class="backlinks-divider" />
      <h3>{lang === "es" ? "Enlaces que apuntan aquí" : "Links pointing here"}</h3>
      <ul class="backlinks-list">
        {backlinks.map((backlink) => (
          <li><a href={backlink.href} class="backlink-link"><span class="backlink-title">{backlink.title}</span><span class="backlink-meta"> ({displayDate(backlink.date)})</span></a></li>
        ))}
      </ul>
    </section>
  )}
</article>

<script is:inline>
  document.addEventListener("DOMContentLoaded", function () {
    var button = document.getElementById("zen-toggle-btn");
    if (!button) return;
    var body = document.body;
    var key = "zen_mode_enabled";
    var returnFrame = null;

    function setZen(enabled) {
      if (returnFrame !== null) {
        cancelAnimationFrame(returnFrame);
        returnFrame = null;
      }

      if (enabled) {
        body.classList.remove("zen-mode-returning");
        body.classList.add("zen-mode");
      } else if (body.classList.contains("zen-mode")) {
        body.classList.add("zen-mode-returning");
        body.classList.remove("zen-mode");
        void body.offsetWidth;
        returnFrame = requestAnimationFrame(function () {
          body.classList.remove("zen-mode-returning");
          returnFrame = null;
        });
      } else {
        body.classList.remove("zen-mode", "zen-mode-returning");
      }

      button.classList.toggle("is-active", enabled);
      try { localStorage.setItem(key, enabled ? "true" : "false"); } catch (error) {}
    }
    try { setZen(localStorage.getItem(key) === "true"); } catch (error) {}
    button.addEventListener("click", function () { setZen(!body.classList.contains("zen-mode")); });
  });
</script>
