---
import TagList from "./TagList.astro";
import { displayDate } from "./_utils";
import type { ContentListItem, Language } from "./types";

interface Props {
  title: string;
  description?: string | null;
  items: ContentListItem[];
  lang?: Language;
  authorMode?: boolean;
  notebook?: string;
  showTags?: boolean;
  editorial?: boolean;
}

const {
  title,
  description = null,
  items,
  lang = "en",
  authorMode = false,
  notebook,
  showTags = true,
  editorial = false,
} = Astro.props;
const displayItems = authorMode ? items : items.filter((item) => !item.hidden);
const addLabel = lang === "es" ? "Nuevo post" : "New post";
const monthAbbreviations = lang === "es"
  ? ["ene", "feb", "mar", "abr", "may", "jun", "jul", "ago", "sep", "oct", "nov", "dic"]
  : ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
const undatedLabel = lang === "es" ? "Sin fecha" : "Undated";

function editorialDate(value: ContentListItem["date"]) {
  const match = displayDate(value).match(/^(\d{4})-(\d{2})-(\d{2})$/);
  if (!match) return null;
  return {
    year: match[1],
    day: `${monthAbbreviations[Number(match[2]) - 1]} ${Number(match[3])}`,
  };
}

const editorialGroups: { year: string | null; rows: { item: ContentListItem; day: string }[] }[] = [];
for (const item of displayItems) {
  const date = editorialDate(item.date);
  const year = date?.year ?? null;
  let group = editorialGroups[editorialGroups.length - 1];
  if (!group || group.year !== year) {
    group = { year, rows: [] };
    editorialGroups.push(group);
  }
  group.rows.push({ item, day: date?.day || displayDate(item.date) || undatedLabel });
}
---

<header class="page-header">
  <div class="page-header-row">
    <h1>{title}</h1>
    {authorMode && (
      <div class="author-inline-actions">
        <button type="button" class="author-action-button" data-author-action="add-post" data-notebook={notebook} aria-label={addLabel} title={addLabel}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><path d="M14 2v6h6"></path><path d="M12 12v6"></path><path d="M9 15h6"></path></svg>
        </button>
        <button type="button" class="author-action-button" data-author-action="add-image-post" aria-label={lang === "es" ? "Nueva publicación con imagen" : "New image post"} title={lang === "es" ? "Nueva publicación con imagen" : "New image post"}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><path d="m21 15-5-5L5 21"></path><path d="M17 2v6"></path><path d="M14 5h6"></path></svg>
        </button>
        <button type="button" class="author-action-button" data-author-action="edit-notebook" aria-label={lang === "es" ? "Editar notebook" : "Edit notebook"} title={lang === "es" ? "Editar notebook" : "Edit notebook"}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"></path><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4Z"></path></svg>
        </button>
      </div>
    )}
  </div>
  {description && <p class="lead">{description}</p>}
</header>

{editorial ? (
  <section class="writing-index" data-writing-index>
    {editorialGroups.map((group) => (
      <div class="writing-index-year">
        <h2 class="writing-index-year-mark">{group.year || undatedLabel}</h2>
        <div class="writing-index-rows">
          {group.rows.map(({ item, day }) => (
            <article class="writing-index-row">
              <span class="writing-index-date">{day}</span>
              <div class="writing-index-main">
                <h3 class="writing-index-title"><a href={item.href}>{item.title}</a></h3>
                {item.summary && <p class="writing-index-summary">{item.summary}</p>}
              </div>
              {showTags && (item.tags?.length ?? 0) > 0 && (
                <p class="writing-index-tags">
                  {(item.tags ?? []).slice(0, 2).map((tag, tagIndex) => (
                    <>
                      {tagIndex > 0 && <span aria-hidden="true"> · </span>}
                      <a href={tag.href}>{tag.label}</a>
                    </>
                  ))}
                </p>
              )}
            </article>
          ))}
        </div>
      </div>
    ))}
  </section>
) : (
  <section class="post-list">
    {displayItems.map((item) => (
      <article class="post-card">
        <div class="post-card-top">
          <div class="post-card-meta">{displayDate(item.date)}</div>
        </div>
        <h2><a href={item.href}>{item.title}</a></h2>
        {showTags && <TagList tags={item.tags} lang={lang} />}
        {!showTags && item.summaryHtml
          ? <Fragment set:html={item.summaryHtml} />
          : item.summary && <p class="post-summary">{item.summary}</p>}
      </article>
    ))}
  </section>
)}
