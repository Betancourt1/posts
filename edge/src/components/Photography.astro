---
import { displayDate } from "./_utils";
import type { Language, PhotoItem } from "./types";

interface Props {
  title: string;
  description?: string | null;
  photos: PhotoItem[];
  lang?: Language;
  authorMode?: boolean;
}

const {
  title,
  description = null,
  photos,
  lang = "en",
  authorMode = false,
} = Astro.props;
const visiblePhotos = photos.filter((photo) => !photo.hidden);
---

<header class="page-header">
  <div class="page-header-row">
    <h1>{title}</h1>
    {authorMode && (
      <div class="author-inline-actions">
        <button type="button" class="author-action-button" data-author-action="add-image-post" aria-label={lang === "es" ? "Nueva publicación con imagen" : "New image post"} title={lang === "es" ? "Nueva publicación con imagen" : "New image post"}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><path d="m21 15-5-5L5 21"></path><path d="M17 2v6"></path><path d="M14 5h6"></path></svg>
        </button>
        <button type="button" class="author-action-button" data-author-action="edit-notebook" aria-label={lang === "es" ? "Editar notebook" : "Edit notebook"} title={lang === "es" ? "Editar notebook" : "Edit notebook"}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"></path><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4Z"></path></svg>
        </button>
      </div>
    )}
  </div>
  {description && <p class="lead">{description}</p>}
</header>

<section class="photo-grid" data-photo-grid>
  {visiblePhotos.map((photo) => {
    const image = photo.thumbnail || photo.image;
    return (
      <article class="photo-card">
        <a class="photo-card-image" href={photo.href} aria-label={photo.title}>
          {image ? (
            <>
              <img src={image} alt={photo.imageAlt || photo.title} loading="lazy" decoding="async" width={photo.width} height={photo.height} />
              {photo.thumbnail && photo.image && photo.thumbnail !== photo.image && <span class="photo-card-preview">preview</span>}
              {(photo.imageCount || 0) > 1 && <span class="photo-card-count">{photo.imageCount} {lang === "es" ? "imágenes" : "images"}</span>}
            </>
          ) : <span>{photo.title}</span>}
        </a>
        <div class="photo-card-meta">{displayDate(photo.date)}</div>
        <h2><a href={photo.href}>{photo.title}</a></h2>
        {(photo.caption || photo.summary) && <p>{photo.caption || photo.summary}</p>}
      </article>
    );
  })}
</section>
