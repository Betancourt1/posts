---
import KnowledgeGraph from "./KnowledgeGraph.astro";
import type { ArchiveMonth, GraphData } from "./types";

interface Props {
  archives?: ArchiveMonth[];
  archivesHref?: string;
  graphData?: GraphData | null;
  showArchives?: boolean;
}

const {
  archives = [],
  archivesHref = "/archives/",
  graphData = null,
  showArchives = true,
} = Astro.props;
---

{graphData && (
  <div class="sidebar-block sidebar-block--graph">
    <KnowledgeGraph data={graphData} variant="sidebar" />
  </div>
)}

{showArchives && <div class="sidebar-block">
  <h3>Archives</h3>
  <ul class="sidebar-list">
    {archives.slice(0, 12).map((month) => (
      <li>
        <a href={`${archivesHref}#${month.key}`}>{month.key}</a>
        <span class="count">{month.count}</span>
      </li>
    ))}
  </ul>
  <a class="sidebar-more" href={archivesHref}>
    View all
  </a>
</div>}
