---
import KnowledgeGraph from "./KnowledgeGraph.astro";
import type { ArchiveMonth, GraphData, Language } from "./types";

interface Props {
  lang?: Language;
  archives?: ArchiveMonth[];
  archivesHref?: string;
  graphData?: GraphData | null;
  friendlyArchiveLabels?: boolean;
}

const {
  lang = "en",
  archives = [],
  archivesHref = lang === "es" ? "/es/archives/" : "/archives/",
  graphData = null,
  friendlyArchiveLabels = false,
} = Astro.props;
const monthNames = lang === "es"
  ? ["enero", "febrero", "marzo", "abril", "mayo", "junio", "julio", "agosto", "septiembre", "octubre", "noviembre", "diciembre"]
  : ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];

function archiveLabel(key: string) {
  if (!friendlyArchiveLabels) return key;
  const [year, month] = key.split("-");
  const index = Number(month) - 1;
  return monthNames[index] && year ? `${monthNames[index]} ${year}` : key;
}
---

{graphData && (
  <div class="sidebar-block sidebar-block--graph">
    <KnowledgeGraph data={graphData} lang={lang} variant="sidebar" />
  </div>
)}

<div class="sidebar-block">
  <h3>{lang === "es" ? "Archivos" : "Archives"}</h3>
  <ul class="sidebar-list">
    {archives.slice(0, 12).map((month) => (
      <li>
        <a href={`${archivesHref}#${month.key}`}>{archiveLabel(month.key)}</a>
        <span class="count">{month.count}</span>
      </li>
    ))}
  </ul>
  <a class="sidebar-more" href={archivesHref}>
    {friendlyArchiveLabels
      ? (lang === "es" ? "Ver todos los archivos" : "View all archives")
      : (lang === "es" ? "Ver todos" : "View all")}
  </a>
</div>
