---
import type { Language, QuoteItem, QuoteRecord, TagItem } from "./types";

interface Props {
  title: string;
  description?: string | null;
  items: QuoteItem[];
  lang?: Language;
  authorMode?: boolean;
  notebook?: string;
}

interface DisplayQuote extends QuoteRecord {
  href: string;
  date: string;
  tags: TagItem[];
  key: string;
  sizeClass: string;
  spanClass: string;
}

function quoteSizeClass(length: number) {
  if (length <= 70) return "quote-size-display";
  if (length <= 140) return "quote-size-large";
  if (length <= 260) return "quote-size-regular";
  return "quote-size-compact";
}

function quoteSpanClass(length: number) {
  if (length >= 700) return "quote-span-extra-wide";
  if (length >= 360) return "quote-span-wide";
  if (length >= 180) return "quote-span-medium";
  return "quote-span-standard";
}

const {
  title,
  description = null,
  items,
  lang = "es",
  authorMode = false,
  notebook,
} = Astro.props;
const addLabel = lang === "es" ? "Nueva cita" : "New quote";
const allQuotes = items
  .filter((item) => !item.hidden)
  .flatMap((item) => item.quotes.map((quote, index) => ({
    ...quote,
    href: item.href,
    date: String(item.date || ""),
    tags: (item.tags || []).filter((tag) => tag.label.toLowerCase() !== "quote").slice(0, 2),
    key: `${item.href}#${index + 1}`,
  })))
  .filter((quote) => quote.text?.trim() && quote.author?.trim());

const editorialSelection = [
  { author: "Michael Polanyi" },
  { author: "bell hooks" },
  { author: "Virginia Woolf" },
  { author: "Mark Fisher", source: "Good for Nothing" },
  { author: "Luis Hermosilla" },
];
const selectedQuotes = editorialSelection
  .map((selection) => allQuotes.find((quote) => quote.author === selection.author
    && (!selection.source || quote.source === selection.source)))
  .filter((quote): quote is Omit<DisplayQuote, "sizeClass" | "spanClass"> => Boolean(quote));
const selectedKeys = new Set(selectedQuotes.map((quote) => quote.key));
const remainingQuotes = allQuotes
  .filter((quote) => !selectedKeys.has(quote.key))
  .sort((left, right) => left.text.length - right.text.length
    || left.author.localeCompare(right.author, lang));
const quoteItems: DisplayQuote[] = [...selectedQuotes, ...remainingQuotes]
  .map((quote) => ({
    ...quote,
    sizeClass: quoteSizeClass(quote.text.length),
    spanClass: quoteSpanClass(quote.text.length),
  }));
---

<section class="quotes-index" data-quotes-index>
  <header class="quotes-page-header">
    <div class="quotes-page-heading">
      <div class="page-header-row">
        <h1>{title}</h1>
        {authorMode && (
          <div class="author-inline-actions">
            <button type="button" class="author-action-button" data-author-action="add-post" data-notebook={notebook} aria-label={addLabel} title={addLabel}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><path d="M14 2v6h6"></path><path d="M12 12v6"></path><path d="M9 15h6"></path></svg>
            </button>
            <button type="button" class="author-action-button" data-author-action="edit-notebook" aria-label={lang === "es" ? "Editar notebook" : "Edit notebook"} title={lang === "es" ? "Editar notebook" : "Edit notebook"}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"></path><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4Z"></path></svg>
            </button>
          </div>
        )}
      </div>
      {description && <p class="lead">{description}</p>}
    </div>
    <div class="quotes-order" role="group" aria-label={lang === "es" ? "Ordenar citas" : "Order quotes"}>
      <span class="quotes-order-label">{lang === "es" ? "orden:" : "order:"}</span>
      <button class="quotes-order-option" type="button" data-quotes-order="recent" aria-pressed="true">
        {lang === "es" ? "recientes" : "newest"}
      </button>
      <button class="quotes-order-option" type="button" data-quotes-order="oldest" aria-pressed="false">
        {lang === "es" ? "antiguas" : "oldest"}
      </button>
      <button class="quotes-order-option" type="button" data-quotes-order="random" aria-pressed="false">
        {lang === "es" ? "aleatorio" : "random"}
      </button>
    </div>
  </header>

  <div class="quotes-catalog">
    <div class="quotes-grid" data-quotes-grid>
      {quoteItems.map((quote, index) => (
        <article
          class:list={["quote-index-entry", quote.sizeClass, quote.spanClass]}
          data-quote-entry
          data-length={quote.text.length}
          data-date={quote.date}
          data-author={quote.author.toLocaleLowerCase(lang)}
          data-sequence={index}
          data-key={quote.key}
        >
          <span class="quote-index-mark" aria-hidden="true">“</span>
          <a class="quote-index-text" href={quote.href}>{quote.text}</a>
          <div class="quote-index-rule" aria-hidden="true"></div>
          <a class="quote-index-author" href={quote.href}>{quote.author}</a>
          {(quote.source || quote.year || quote.page) && (
            <p class="quote-index-source">
              {quote.source && <cite>{quote.source}</cite>}
              {quote.source && quote.year && ", "}
              {quote.year}
              {quote.page && ` · p. ${quote.page}`}
            </p>
          )}
          {quote.tags.length > 0 && (
            <p class="quote-index-tags">
              {quote.tags.map((tag, tagIndex) => (
                <>
                  {tagIndex > 0 && <span aria-hidden="true"> · </span>}
                  <a href={tag.href}>{tag.label}</a>
                </>
              ))}
            </p>
          )}
        </article>
      ))}
    </div>
  </div>
</section>

<script is:inline>
  document.addEventListener("DOMContentLoaded", function () {
    var root = document.querySelector("[data-quotes-index]");
    if (!root) return;
    var grid = root.querySelector("[data-quotes-grid]");
    var orderOptions = Array.from(root.querySelectorAll("[data-quotes-order]"));
    if (!grid || !orderOptions.length) return;

    var entries = Array.from(grid.querySelectorAll("[data-quote-entry]"));
    var layoutFrame = 0;
    var lastGridWidth = 0;

    function value(entry, name) {
      return entry.getAttribute(name) || "";
    }

    function spanFor(entry, columns) {
      if (columns <= 1) return 1;
      if (columns === 8) return Number(value(entry, "data-length")) >= 260 ? 8 : 4;
      var length = Number(value(entry, "data-length"));
      if (length >= 700) return 8;
      if (length >= 360) return 6;
      if (length >= 180) return 4;
      if (length >= 90) return 3;
      return 2;
    }

    function packEntries() {
      layoutFrame = 0;
      var columns = Number(getComputedStyle(grid).getPropertyValue("--quote-columns")) || 1;
      var visibleEntries = entries.filter(function (entry) {
        return getComputedStyle(entry).display !== "none";
      });

      grid.classList.remove("is-packed");
      grid.style.height = "";
      entries.forEach(function (entry) {
        entry.style.width = "";
        entry.style.transform = "";
      });

      if (columns <= 1) return;

      var columnWidth = grid.clientWidth / columns;
      var heights = Array(columns).fill(0);
      grid.classList.add("is-packed");

      visibleEntries.forEach(function (entry) {
        var span = Math.min(spanFor(entry, columns), columns);
        var width = columnWidth * span;
        entry.style.width = width + "px";

        var bestStart = 0;
        var bestTop = Infinity;
        for (var start = 0; start <= columns - span; start += 1) {
          var top = Math.max.apply(null, heights.slice(start, start + span));
          if (top < bestTop) {
            bestTop = top;
            bestStart = start;
          }
        }

        entry.style.transform = "translate(" + (bestStart * columnWidth) + "px, " + bestTop + "px)";
        var bottom = bestTop + entry.offsetHeight;
        for (var column = bestStart; column < bestStart + span; column += 1) {
          heights[column] = bottom;
        }
      });

      grid.style.height = Math.max.apply(null, heights) + "px";
    }

    function scheduleLayout() {
      if (layoutFrame) cancelAnimationFrame(layoutFrame);
      layoutFrame = requestAnimationFrame(packEntries);
    }

    function sortEntries(mode) {
      orderOptions.forEach(function (option) {
        option.setAttribute("aria-pressed", value(option, "data-quotes-order") === mode ? "true" : "false");
      });
      if (mode === "random") {
        for (var index = entries.length - 1; index > 0; index -= 1) {
          var swapIndex = Math.floor(Math.random() * (index + 1));
          var current = entries[index];
          entries[index] = entries[swapIndex];
          entries[swapIndex] = current;
        }
      } else {
        entries.sort(function (left, right) {
          var dateOrder = mode === "oldest"
            ? value(left, "data-date").localeCompare(value(right, "data-date"))
            : value(right, "data-date").localeCompare(value(left, "data-date"));
          return dateOrder
            || value(left, "data-author").localeCompare(value(right, "data-author"))
            || Number(value(left, "data-sequence")) - Number(value(right, "data-sequence"));
        });
      }
      entries.forEach(function (entry) {
        grid.appendChild(entry);
      });
      scheduleLayout();
    }

    orderOptions.forEach(function (option) {
      option.addEventListener("click", function () { sortEntries(value(option, "data-quotes-order")); });
    });
    sortEntries("recent");

    if ("ResizeObserver" in window) {
      var resizeObserver = new ResizeObserver(function () {
        var width = grid.clientWidth;
        if (Math.abs(width - lastGridWidth) > 0.5) {
          lastGridWidth = width;
          scheduleLayout();
        }
      });
      resizeObserver.observe(grid);
    } else {
      window.addEventListener("resize", scheduleLayout);
    }
    new MutationObserver(scheduleLayout).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["class", "style"],
    });
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(scheduleLayout);
  });
</script>

<noscript><style>.quotes-order { display: none !important; }.quotes-grid { --quote-columns: 1; grid-template-columns: 1fr; }.quote-index-entry { display: block !important; grid-column: 1 / -1 !important; }</style></noscript>
