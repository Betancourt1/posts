---
import TagList from "./TagList.astro";
import type { Language, TagItem } from "./types";

interface Props {
  title: string;
  terms: TagItem[];
  lang?: Language;
}

const { title, terms, lang = "en" } = Astro.props;
const visibleTerms = terms
  .filter((term) => term.count === undefined || term.count > 0)
  .sort((left, right) => left.label.localeCompare(right.label, lang));
---

<header class="page-header"><h1>{title}</h1></header>
<TagList tags={visibleTerms} lang={lang} cloud />
