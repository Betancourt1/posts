---
import type { Language, NavItem } from "./types";

interface Props {
  items: NavItem[];
  lang?: Language;
  activePath?: string;
  activeSection?: string;
  authorMode?: boolean;
  menuMode?: boolean;
}

const {
  items,
  lang = "en",
  activePath = Astro.url.pathname,
  activeSection = "",
  authorMode = false,
  menuMode = false,
} = Astro.props;
const showLabel = menuMode
  ? (lang === "es" ? "Menú" : "Menu")
  : (lang === "es" ? "Mostrar notebooks" : "Show notebooks");
const hideLabel = menuMode
  ? (lang === "es" ? "Cerrar" : "Close")
  : (lang === "es" ? "Ocultar notebooks" : "Hide notebooks");
const toggleLabel = menuMode ? (lang === "es" ? "Menú" : "Menu") : "Notebooks";
const newNotebook = lang === "es" ? "Nuevo notebook" : "New notebook";
---

<nav
  class:list={["nav", { "nav--author": authorMode }]}
  id="site-navigation"
  data-collapsible-nav
  data-show-label={showLabel}
  data-hide-label={hideLabel}
>
  <div class:list={["nav-author-row", { "nav-author-row--public": !authorMode }]}>
    {authorMode && <span class="nav-title">Notebooks</span>}
    <button type="button" class="nav-toggle" aria-controls="primary-navigation" aria-expanded="false" hidden>
      {toggleLabel}
    </button>
    {authorMode && (
      <button type="button" class="author-action-button" data-author-action="add-notebook" aria-label={newNotebook} title={newNotebook}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3 5h6l2 2h10v12H3z"></path><path d="M12 10v6"></path><path d="M9 13h6"></path>
        </svg>
      </button>
    )}
  </div>
  <ul class="nav-list" id="primary-navigation">
    {items.map((item) => {
      const active = item.active === true
        || (item.section && item.section === activeSection)
        || item.href === activePath;
      return (
        <li>
          <a
            href={item.href}
            class:list={{ active }}
            target={item.external ? "_blank" : undefined}
            rel={item.external ? "noopener noreferrer" : undefined}
          >
            {item.title}
          </a>
        </li>
      );
    })}
  </ul>
</nav>

<script is:inline>
  (function () {
    var nav = document.getElementById("site-navigation");
    if (!nav) return;

    var toggle = nav.querySelector(".nav-toggle");
    var list = document.getElementById("primary-navigation");
    var mobileLayout = window.matchMedia("(max-width: 1000px)");
    var storageKey = "notebooks_navigation_expanded";
    if (!toggle || !list) return;

    function readExpanded() {
      try {
        return sessionStorage.getItem(storageKey) === "true";
      } catch (error) {
        return false;
      }
    }

    function rememberExpanded(expanded) {
      try {
        sessionStorage.setItem(storageKey, expanded ? "true" : "false");
      } catch (error) {}
    }

    function setExpanded(expanded, remember) {
      toggle.setAttribute("aria-expanded", expanded ? "true" : "false");
      list.hidden = !expanded;
      toggle.textContent = expanded ? nav.dataset.hideLabel : nav.dataset.showLabel;
      if (remember) rememberExpanded(expanded);
    }

    function syncLayout() {
      if (mobileLayout.matches) {
        toggle.hidden = false;
        setExpanded(readExpanded(), false);
        return;
      }
      toggle.hidden = true;
      toggle.setAttribute("aria-expanded", "false");
      list.hidden = false;
    }

    toggle.addEventListener("click", function () {
      setExpanded(toggle.getAttribute("aria-expanded") !== "true", true);
    });
    mobileLayout.addEventListener("change", syncLayout);
    syncLayout();
  })();
</script>
