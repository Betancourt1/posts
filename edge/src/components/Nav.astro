---
import type { Language, NavItem } from "./types";

interface Props {
  items: NavItem[];
  lang?: Language;
  activePath?: string;
  activeSection?: string;
  authorMode?: boolean;
}

const {
  items,
  lang = "en",
  activePath = Astro.url.pathname,
  activeSection = "",
  authorMode = false,
} = Astro.props;
const showLabel = lang === "es" ? "Mostrar notebooks" : "Show notebooks";
const hideLabel = lang === "es" ? "Ocultar notebooks" : "Hide notebooks";
const archivesPath = authorMode ? (lang === "es" ? "/admin/es/archives/" : "/admin/archives/") : (lang === "es" ? "/es/archives/" : "/archives/");
---

<nav
  class="nav"
  id="site-navigation"
  data-collapsible-nav
  data-show-label={showLabel}
  data-hide-label={hideLabel}
>
  <div class="nav-author-row nav-author-row--public">
    <button type="button" class="nav-toggle" aria-controls="primary-navigation" aria-expanded="false" hidden>
      Notebooks
    </button>
  </div>
  <ul class="nav-list" id="primary-navigation">
    {items.map((item) => {
      const active = item.active === true
        || (item.section && item.section === activeSection)
        || item.href === activePath;
      return (
        <li>
          <a
            href={item.href}
            class:list={{ active }}
            target={item.external ? "_blank" : undefined}
            rel={item.external ? "noopener noreferrer" : undefined}
          >
            {item.title}
          </a>
        </li>
      );
    })}
    <li>
      <a
        href={archivesPath}
        class:list={{ active: activePath === archivesPath }}
        aria-current={activePath === archivesPath ? "page" : undefined}
      >{lang === "es" ? "Archivos" : "Archives"}</a>
    </li>
  </ul>
</nav>

<script is:inline>
  (function () {
    var nav = document.getElementById("site-navigation");
    if (!nav) return;

    var toggle = nav.querySelector(".nav-toggle");
    var headerToggle = document.getElementById("site-menu-toggle");
    var list = document.getElementById("primary-navigation");
    var mobileLayout = window.matchMedia("(max-width: 1000px)");
    var storageKey = "notebooks_navigation_expanded";
    if (!toggle || !list) return;

    function readExpanded() {
      try {
        return sessionStorage.getItem(storageKey) === "true";
      } catch (error) {
        return false;
      }
    }

    function rememberExpanded(expanded) {
      try {
        sessionStorage.setItem(storageKey, expanded ? "true" : "false");
      } catch (error) {}
    }

    function setExpanded(expanded, remember) {
      toggle.setAttribute("aria-expanded", expanded ? "true" : "false");
      if (headerToggle) headerToggle.setAttribute("aria-expanded", expanded ? "true" : "false");
      list.hidden = !expanded;
      toggle.textContent = expanded ? nav.dataset.hideLabel : nav.dataset.showLabel;
      if (remember) rememberExpanded(expanded);
    }

    function syncLayout() {
      if (mobileLayout.matches) {
        toggle.hidden = Boolean(headerToggle);
        if (headerToggle) headerToggle.hidden = false;
        setExpanded(readExpanded(), false);
        return;
      }
      toggle.hidden = true;
      if (headerToggle) headerToggle.hidden = true;
      toggle.setAttribute("aria-expanded", "false");
      list.hidden = false;
    }

    toggle.addEventListener("click", function () {
      setExpanded(toggle.getAttribute("aria-expanded") !== "true", true);
    });
    if (headerToggle) headerToggle.addEventListener("click", function () {
      setExpanded(headerToggle.getAttribute("aria-expanded") !== "true", true);
    });
    document.addEventListener("keydown", function (event) {
      if (event.key === "Escape" && mobileLayout.matches && !list.hidden
        && (nav.contains(document.activeElement) || document.activeElement === headerToggle)) {
        setExpanded(false, true);
        (headerToggle || toggle).focus();
      }
    });
    mobileLayout.addEventListener("change", syncLayout);
    syncLayout();
  })();
</script>
