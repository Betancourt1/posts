---
import Nav from "../components/Nav.astro";
import WanderingSnail from "../components/WanderingSnail.astro";
import Sidebar from "../components/Sidebar.astro";
import AuthorTools from "../components/AuthorTools.astro";
import KnowledgeGraph from "../components/KnowledgeGraph.astro";
import cvVisitScript from "../../client/cv-visit.js?raw";
import { displayDate, safeJson } from "../components/_utils";
import type {
  ArchiveMonth,
  NavItem,
  ShellPage,
} from "../components/types";

interface Props {
  page: ShellPage;
  currentPath: string;
  activeSection?: string;
  navigation: NavItem[];
  archiveMonths?: ArchiveMonth[];
  title: string;
  description?: string;
  pageClass?: string;
  showSidebar?: boolean;
  showSearch?: boolean;
  hasSidenotes?: boolean;
  authorMode?: boolean;
  siteTitle?: string;
  socialImage?: string;
  canonical?: string;
  enableInfrastructure?: boolean;
}

const {
  page,
  currentPath,
  activeSection = page.section,
  navigation,
  archiveMonths = [],
  title,
  description = "Readings and essays by Betancourt.",
  pageClass = "",
  showSidebar = page.layout !== "not-found",
  showSearch = true,
  hasSidenotes = false,
  authorMode = false,
  siteTitle = "betancourt",
  socialImage = page.socialImage || "/og-image.png",
  canonical = page.canonical || Astro.url.href,
  enableInfrastructure = true,
} = Astro.props;

const pageTitle = page.isHome ? siteTitle : `${title} | ${siteTitle}`;
const origin = Astro.site || new URL(Astro.url.origin);
const socialImageUrl = /^https?:\/\//.test(socialImage)
  ? socialImage
  : new URL(socialImage, origin).toString();
const isBooks = page.layout === "books";
const bookCoverOrigins = [
  "https://covers.openlibrary.org",
  "https://is1-ssl.mzstatic.com",
  "https://m.media-amazon.com",
  "https://images-na.ssl-images-amazon.com",
];
const isPhotography = page.layout === "photography";
const isQuotes = page.layout === "quotes";
const isNotFound = page.layout === "not-found";
const bodyClass = ["public-site", pageClass, hasSidenotes ? "has-sidenotes" : "", authorMode ? "author-mode" : "", isQuotes ? "quotes-index-page" : "", isNotFound ? "not-found" : ""].filter(Boolean).join(" ");
const updatedAt = page.updatedAt || new Date();
const updatedDate = displayDate(updatedAt);
const updatedLabel = updatedDate
  ? `${updatedDate.slice(8, 10)}/${updatedDate.slice(5, 7)}/${updatedDate.slice(0, 4)}`
  : "";
const infrastructureTree = page.infrastructureTree || { type: "dir", name: "/", children: [] };
const homePath = authorMode ? "/admin/" : "/";
const archivesPath = authorMode ? "/admin/archives/" : "/archives/";
---

<!doctype html>
<html lang="en" data-infra-path={page.sourcePath || undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {Astro.url.searchParams.has("cv_id") && <meta name="referrer" content="no-referrer" />}
    {!authorMode && !isNotFound && <script is:inline set:html={cvVisitScript}></script>}
    {page.noindex && <meta name="robots" content="noindex" />}
    <script is:inline>
      (function () {
        var theme = "dark";
        try {
          var savedTheme = localStorage.getItem("site_theme");
          if (savedTheme === "light" || savedTheme === "dark") theme = savedTheme;
          if (localStorage.getItem("grayscale_mode_enabled") === "true") {
            document.documentElement.classList.add("grayscale-mode");
          }
          var size = localStorage.getItem("site_font_size");
          if (size) document.documentElement.style.setProperty("--site-font-size", size + "%");
          var font = localStorage.getItem("site_font_type");
          var stacks = {
            mono: '"JetBrains Mono", "IBM Plex Mono", monospace',
            sans: 'system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif',
            serif: 'Georgia, Cambria, "Times New Roman", Times, serif'
          };
          if (stacks[font]) document.documentElement.style.setProperty("--article-font-family", stacks[font]);
        } catch (error) {}
        document.documentElement.setAttribute("data-theme", theme);
      })();
    </script>
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={page.kind === "page" ? "article" : "website"} />
    <meta property="og:image" content={socialImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <link rel="preload" href="/fonts/Jersey10-Regular.woff2" as="font" type="font/woff2" crossorigin />
    {hasSidenotes && <link rel="preload" href="/fonts/Doto-Variable.woff2" as="font" type="font/woff2" crossorigin />}
    {isBooks && bookCoverOrigins.map((origin) => (
      <>
        <link rel="dns-prefetch" href={origin} />
        <link rel="preconnect" href={origin} />
      </>
    ))}
    <link rel="stylesheet" href="/css/site.css" />
    <link rel="stylesheet" href="/vendor/katex/katex.min.css" />
    <link rel="apple-touch-icon" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="manifest" href="/site.webmanifest" />
  </head>

  <body class={bodyClass || undefined}>
    {authorMode && <AuthorTools sourcePath={page.sourcePath} kind={page.kind} section={page.section} />}
    <header class="site-header">
      <p class="site-title"><a href={homePath}>{siteTitle}</a></p>
      <button type="button" class="site-menu-toggle" id="site-menu-toggle" aria-controls="primary-navigation" aria-expanded="false" hidden>Menu</button>
      <Nav items={navigation} activePath={currentPath} activeSection={activeSection} authorMode={authorMode} />
      <details class="site-header-actions" id="site-preferences" open>
        <summary class="site-preferences-toggle">Settings</summary>
        <div class="site-preferences-controls">
        {authorMode && <details class="author-more-actions">
          <summary class="author-action-button" aria-label="Author tools" title="Author tools">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"></path><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4Z"></path></svg>
          </summary>
          <div class="author-more-menu">
            <button type="button" class="author-action-button" data-author-action="add-notebook">New notebook</button>
            {page.isHome && page.sourcePath && <button type="button" class="author-action-button" data-author-action="edit-home" data-source-path={page.sourcePath}>Edit home page</button>}
            <a class="author-menu-link" href="/admin/cv-links/">CV links</a>
          </div>
        </details>}
        <div class="typo-container">
          <button class="typo-toggle" id="typo-toggle" type="button" aria-label="Text settings" title="Text settings">Aa</button>
          <div class="typo-dropdown" id="typo-dropdown">
            <div class="typo-title">TEXT</div>
            <div class="typo-section">
              <span class="typo-label">Size</span>
              <div class="typo-control-row">
                <button type="button" id="font-size-dec" class="typo-btn" title="Decrease font size">A-</button>
                <button type="button" id="font-size-reset" class="typo-btn" title="Reset font size">100%</button>
                <button type="button" id="font-size-inc" class="typo-btn" title="Increase font size">A+</button>
              </div>
            </div>
            <div class="typo-section" style="margin-top: 12px;">
              <span class="typo-label">Font</span>
              <div class="typo-control-row">
                <button type="button" class="typo-btn-choice" data-font="mono" title="Monospace"><span class="font-preview-mono">Mono</span></button>
                <button type="button" class="typo-btn-choice" data-font="sans" title="Sans-Serif"><span class="font-preview-sans">Sans</span></button>
                <button type="button" class="typo-btn-choice" data-font="serif" title="Serif"><span class="font-preview-serif">Serif</span></button>
              </div>
            </div>
          </div>
        </div>
        <button class="grayscale-toggle" id="grayscale-toggle" type="button" aria-label="Enable grayscale" title="Enable grayscale" aria-pressed="false" data-label-enable="Enable grayscale" data-label-disable="Disable grayscale">
          <svg class="header-display-icon pipette-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m12 9-8.414 8.414A2 2 0 0 0 3 18.828v1.344a2 2 0 0 1-.586 1.414A2 2 0 0 1 3.828 21h1.344a2 2 0 0 0 1.414-.586L15 12"></path>
            <path d="m18 9 .4.4a1 1 0 1 1-3 3l-3.8-3.8a1 1 0 1 1 3-3l.4.4 3.4-3.4a1 1 0 1 1 3 3z"></path>
            <path d="m2 22 .414-.414"></path>
          </svg>
        </button>
        <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Change to light theme" title="Change to light theme" data-label-light="Change to light theme" data-label-dark="Change to dark theme">
          <svg class="header-display-icon theme-contrast-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10"></circle><path d="M12 2a10 10 0 0 1 0 20V2z" fill="currentColor"></path>
          </svg>
        </button>
        <button class="snail-toggle" id="snail-toggle" type="button" aria-label="Hide snails" title="Hide snails" aria-pressed="true" data-label-show="Show snails" data-label-hide="Hide snails">
          <svg class="header-display-icon" viewBox="0 0 32 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M24 7V2m5 5V2M23 9h5c2 0 3 2 3 4v5c0 2-2 3-4 3H3c-1 0-1-2 1-2h3" />
            <path d="M22 13a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
            <path d="M13 8a5 5 0 1 1-5 5c0-2 2-3 4-3s3 1 3 3-1 2-2 2" />
          </svg>
        </button>
        <button class="sound-toggle" id="sound-toggle" type="button" aria-label="Enable sounds" title="Enable sounds" aria-pressed="false" data-label-enable="Enable sounds" data-label-disable="Disable sounds">
          <svg class="header-display-icon sound-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M11 5 6 9H3v6h3l5 4V5z"></path>
            <path class="sound-wave" d="M15 9a4 4 0 0 1 0 6"></path>
            <path class="sound-slash" d="m16 8 5 8"></path>
          </svg>
        </button>
        </div>
      </details>
      {showSearch && (
        <div class="site-header-search" id="search">
          <button type="button" class="search-toggle" aria-label="Search" aria-expanded="false" aria-controls="site-search-panel"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg></button>
          <div class="search-panel" id="site-search-panel" hidden>
          <form class="search-ui__form" role="search">
            <svg class="search-command-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
            <input class="search-ui__search-input" id="site-search-input" type="search" autocomplete="off" spellcheck="false" placeholder="search the archive" aria-label="Search the archive" aria-controls="site-search-results" aria-expanded="false" />
            <kbd class="search-kbd">Ctrl K</kbd>
          </form>
          <div class="search-ui__drawer" id="site-search-results" hidden>
            <div class="search-ui__results-area">
              <p class="search-ui__message" aria-live="polite">Type to search.</p>
              <ol class="search-ui__results"></ol>
            </div>
          </div>
          </div>
        </div>
      )}
    </header>
    <script is:inline src="/js/site-preferences.js" defer></script>

    <WanderingSnail />
    <div class:list={["layout", { "layout--quotes-index": isQuotes }]}>
      <main class:list={["column", "content-column", { "content-column--books": isBooks, "content-column--photo-index": isPhotography, "content-column--quotes-index": isQuotes }]}>
        <div class="content-inner"><slot /></div>
      </main>
      {showSidebar && (
        <aside class:list={["column", "sidebar-column", { "sidebar-column--sidenotes": hasSidenotes }]}>
          {hasSidenotes
            ? (
              <div class="sidenote-sidebar">
                {page.graphData && (
                  <div class="sidebar-block sidebar-block--graph sidenote-sidebar-graph">
                    <KnowledgeGraph data={page.graphData} variant="sidebar" />
                  </div>
                )}
                <div class="sidenote-rail" id="sidenote-rail"></div>
              </div>
            )
            : <Sidebar archives={archiveMonths} archivesHref={archivesPath} graphData={page.isHome ? null : page.graphData} showArchives={false} />}
        </aside>
      )}
    </div>

    <footer class="site-footer">
      <p class="site-footer-updated">
        Last updated:
         <time datetime={updatedDate}>{updatedLabel}</time>
      </p>
    </footer>

    {enableInfrastructure && (
      <>
        <script is:inline type="application/json" id="infra-sitemap" set:html={safeJson(infrastructureTree)}></script>
        <button class="ssh-terminal-open-btn" id="ssh-terminal-open" type="button" aria-label="Open terminal, Ctrl backtick" title="Terminal (Ctrl+`)">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="4 17 10 11 4 5"></polyline><line x1="12" y1="19" x2="20" y2="19"></line></svg>
        </button>
        <div class="ssh-terminal-overlay" id="ssh-terminal-overlay">
          <div class="ssh-terminal-drag-handle" id="ssh-terminal-drag-handle"></div>
          <div class="ssh-terminal">
            <div class="ssh-terminal-titlebar">
              <span class="ssh-terminal-title">visitor@betancourt.work — bash</span>
              <button class="ssh-terminal-close" id="ssh-terminal-close" type="button" aria-label="Close terminal">&times;</button>
            </div>
            <div class="ssh-terminal-body">
              <div class="ssh-terminal-output" id="ssh-terminal-output"></div>
              <div class="ssh-terminal-input-line">
                <span class="ssh-terminal-prompt" id="ssh-terminal-prompt"></span>
                <input type="text" class="ssh-terminal-input" id="ssh-terminal-input" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" />
              </div>
            </div>
          </div>
        </div>
      </>
    )}

    <script is:inline>
      document.addEventListener("DOMContentLoaded", function () {
        var root = document.documentElement;
        var themeToggle = document.getElementById("theme-toggle");
        var grayscaleToggle = document.getElementById("grayscale-toggle");

        function applyTheme(theme) {
          root.setAttribute("data-theme", theme);
          if (themeToggle) {
            var label = theme === "light" ? themeToggle.dataset.labelDark : themeToggle.dataset.labelLight;
            themeToggle.setAttribute("aria-label", label);
            themeToggle.setAttribute("title", label);
          }
        }
        if (themeToggle) {
          applyTheme(root.getAttribute("data-theme") || "dark");
          themeToggle.addEventListener("click", function () {
            var next = root.getAttribute("data-theme") === "dark" ? "light" : "dark";
            applyTheme(next);
            try { localStorage.setItem("site_theme", next); } catch (error) {}
          });
        }

        function applyGrayscale(enabled) {
          root.classList.toggle("grayscale-mode", enabled);
          if (grayscaleToggle) {
            var label = enabled ? grayscaleToggle.dataset.labelDisable : grayscaleToggle.dataset.labelEnable;
            grayscaleToggle.classList.toggle("is-active", enabled);
            grayscaleToggle.setAttribute("aria-pressed", enabled ? "true" : "false");
            grayscaleToggle.setAttribute("aria-label", label);
            grayscaleToggle.setAttribute("title", label);
          }
        }
        var grayscale = root.classList.contains("grayscale-mode");
        applyGrayscale(grayscale);
        if (grayscaleToggle) {
          grayscaleToggle.addEventListener("click", function () {
            grayscale = !grayscale;
            applyGrayscale(grayscale);
            try { localStorage.setItem("grayscale_mode_enabled", grayscale ? "true" : "false"); } catch (error) {}
          });
        }

      });
    </script>
    <script is:inline src="/js/knowledge-graph.js" defer></script>
    <script is:inline src="/js/infrastructure.js" defer></script>
    {showSearch && <script is:inline src="/js/search.js" defer></script>}
    <script is:inline src="/js/typography.js" defer></script>
    <script is:inline src="/js/curved-scrollbar.js" defer></script>
    <script is:inline src="/js/sound.js" defer></script>
    <script is:inline type="module" src="/js/technical-content.js"></script>
    {isPhotography && <script is:inline src="/js/photography-grid.js" defer></script>}
    {isBooks && <script is:inline type="module" src="/js/books.js"></script>}
    {hasSidenotes && <script is:inline src="/js/sidenote-reading.js" defer></script>}
    {authorMode && <script is:inline src="/js/author-tools.js" defer></script>}
  </body>
</html>
