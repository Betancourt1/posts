---
import { env } from "cloudflare:workers";

import PublicPage from "../views/PublicPage.astro";
import { loadNotFoundPage, loadPublicPage } from "../lib/public-page.mjs";

export const prerender = false;

let model: any = await loadPublicPage(env.DB, Astro.url.pathname);
if (model?.redirect) return Astro.redirect(model.redirect, 301);
if (!model) {
  Astro.response.status = 404;
  model = await loadNotFoundPage(env.DB, Astro.url.pathname);
}
const authorMode = String(env.AUTHOR_MODE) === "true";
---

<PublicPage model={model} authorMode={authorMode} />
