---
import { env } from "cloudflare:workers";

import PublicPage from "../views/PublicPage.astro";
import { loadNotFoundPage, loadPublicPage } from "../lib/public-page.mjs";

export const prerender = false;

let model: any = await loadPublicPage(env.DB, "/");
if (model?.redirect) return Astro.redirect(model.redirect + Astro.url.search, 301);
if (!model) {
  Astro.response.status = 404;
  model = await loadNotFoundPage(env.DB, "/");
}
const authorMode = String(env.AUTHOR_MODE) === "true";
---

<PublicPage model={model} authorMode={authorMode} />
