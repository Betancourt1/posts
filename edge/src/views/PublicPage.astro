---
import Archives from "../components/Archives.astro";
import Books from "../components/Books.astro";
import CvLinks from "../components/CvLinks.astro";
import Guestbook from "../components/Guestbook.astro";
import KnowledgeGraph from "../components/KnowledgeGraph.astro";
import List from "../components/List.astro";
import NotFound from "../components/NotFound.astro";
import Photography from "../components/Photography.astro";
import ProjectCatalog from "../components/ProjectCatalog.astro";
import ProjectOverview from "../components/ProjectOverview.astro";
import Quotes from "../components/Quotes.astro";
import ReadingForm from "../components/ReadingForm.astro";
import Single from "../components/Single.astro";
import TagList from "../components/TagList.astro";
import Tags from "../components/Tags.astro";
import { displayDate } from "../components/_utils.js";
import SiteLayout from "../layouts/SiteLayout.astro";
import { removeLegacyLinkSpacing, renderMarkdownSummary } from "../lib/content-projector.mjs";
import { adminPathForPublicRoute } from "../lib/public-page.mjs";
import { contentExcerpt } from "../lib/content-excerpt.mjs";
import type { ShellPage } from "../components/types";
import { isBookContentPath } from "../../../functions/_lib/book-content.js";

interface Props {
  model: any;
  authorMode?: boolean;
}

const { model, authorMode = false } = Astro.props;
const page = model.page || {};
const frontMatter = page.frontMatter || {};

function contentHref(path: string) {
  return authorMode ? adminPathForPublicRoute(path) : path;
}

function tagHref(slug: string) {
  return contentHref(`/tags/${slug}/`);
}

function tagsFor(document: any) {
  return (document.tags || []).map((tag: any) => ({
    label: tag.label,
    slug: tag.slug,
    href: tagHref(tag.slug),
  }));
}

function photoImages(value: unknown) {
  if (!Array.isArray(value)) return [];
  return value.flatMap((image: any) => image?.src ? [{
    src: image.src,
    thumb: image.thumb || image.thumbnail || null,
    alt: image.alt || image.image_alt || null,
    caption: image.caption || null,
  }] : []);
}

function listItem(document: any) {
  const gallery = photoImages(document.frontMatter?.images);
  const first = gallery[0];
  return {
    title: document.title,
    href: contentHref(document.path),
    date: document.date,
    summary: contentExcerpt(document),
    tags: tagsFor(document),
    section: document.section,
    draft: document.draft,
    hidden: document.hidden,
    essay: document.frontMatter?.essay === true,
    featured: document.frontMatter?.featured === true,
    image: document.frontMatter?.image || first?.src || null,
    thumbnail: document.frontMatter?.thumbnail || document.frontMatter?.thumb || first?.thumb || null,
    imageAlt: document.frontMatter?.image_alt || first?.alt || null,
    caption: document.frontMatter?.caption || first?.caption || null,
    imageCount: gallery.length,
    width: document.frontMatter?.width,
    height: document.frontMatter?.height,
  };
}

function taxonomyItem(document: any) {
  return {
    ...listItem(document),
    summaryHtml: document.summary
      ? renderMarkdownSummary(document.summary)
      : renderMarkdownSummary(document.bodyMarkdown || "", { wordLimit: 70 }),
  };
}

function navigationItems(sections: any[]) {
  const visiblePaths = new Set(sections.map((section) => section.path));
  const preferred = [
        ["Home", "/", ""],
        ["About", "/about/", "about"],
        ["Projects", "/proyectos-profesionales/", "proyectos-profesionales"],
        ["Blog", "/posts/", "posts"],
        ["Quotes", "/lit/", "lit"],
        ["Photography", "/fotografia/", "fotografia"],
        ["Books", "/books/", "books"],
        ["Guestbook", "/guestbook/", "guestbook"],
      ];
  const items = preferred
    .filter(([, href]) => visiblePaths.has(href))
    .map(([title, href, section]) => ({ title, href, section }));
  const represented = new Set(items.map((item) => item.href));

  for (const section of sections) {
    if (represented.has(section.path)) continue;
    items.push({ title: section.title, href: section.path, section: section.section });
  }
  return items.map((item) => ({ ...item, href: contentHref(item.href) }));
}

function bookReview(markdown: string) {
  const match = String(markdown || "").match(
    /(?:^|\n)## (?:My review|Mi reseña)\s*\n+([\s\S]*?)(?=\n##\s|$)/,
  );
  return match?.[1]?.trim() || null;
}

function badgeLabel(section: string) {
  const labels: Record<string, string> = {
    posts: "post",
    "proyectos-profesionales": "project",
    zettelkasten: "zettel",
    lit: "quote",
    fotografia: "photo",
    books: "book",
    libros: "book",
  };
  return labels[section] || section;
}

const layout = ["books", "photography", "quotes", "guestbook", "not-found"].includes(model.layout)
  ? model.layout
  : "default";
const emptyGraph = { posts: [], tagLinks: {} };
const ignoredGraphTags = new Set([
  "book", "read", "currently-reading", "to-read", "essays", "essay", "note", "quote",
  "libro", "leído", "leyendo", "por-leer", "ensayo", "nota", "zettelkasten", "cita",
]);
const canonical = new URL(model.layout === "cv-links" ? contentHref(model.path) : model.path, Astro.site || Astro.url.origin).href;
const shellPage: ShellPage = {
  section: page.section,
  kind: model.kind,
  layout,
  sourcePath: page.sourcePath,
  canonical,
  socialImage: frontMatter.image || "/og-image.png",
  noindex: page.hidden || page.draft || model.kind === "not-found",
  isHome: model.layout === "home",
  updatedAt: model.updatedAt || page.updatedAt,
  graphData: {
    ...emptyGraph,
    focusTags: model.layout === "tag"
      ? []
      : tagsFor(page)
          .map((tag: any) => tag.label)
          .filter((tag: string) => !ignoredGraphTags.has(tag.toLowerCase())),
  },
  infrastructureTree: { type: "dir", name: "/", children: [] },
};
const navigation = navigationItems(model.navigation || []);
const items = (model.items || []).map(listItem);
const recentItems = (model.recentItems || []).map((document: any) => ({
  ...listItem(document),
  summary: document.summary || document.description || document.bodyText?.slice(0, 220),
}));
const title = model.title || ("Untitled");
const description = model.description || undefined;
const hasSidenotes = model.layout === "single" && String(page.bodyHtml || "").includes('class="sidenote-endnotes"');
---

<SiteLayout
  page={shellPage}
  currentPath={contentHref(model.path)}
  activeSection={page.section === "posts" && frontMatter.technical === true ? "proyectos-profesionales" : page.section}
  navigation={navigation}
  archiveMonths={model.archiveMonths || []}
  title={title}
  description={description}
  hasSidenotes={hasSidenotes}
  authorMode={authorMode}
  canonical={canonical}
  showSidebar={model.layout === "cv-links" ? false : undefined}
  showSearch
>
  {authorMode && model.layout === "cv-links" && <CvLinks />}
  {model.layout === "home" && (
    <>
      {page.bodyHtml && <section class="post-body" set:html={removeLegacyLinkSpacing(page.bodyHtml)}></section>}
      {items.length > 0 && (
        <section class="home-section home-feed">
          <div class="home-section-head">
            <h2>Selected writing</h2>
            <span class="sidebar-more">
              <a href={contentHref("/posts/")}>
                All writing →
              </a>
            </span>
          </div>
          <div class="post-list">
            {items.map((item: any) => {
              const isPhoto = item.section === "fotografia" && Boolean(item.thumbnail || item.image);
              const photoSrc = item.thumbnail || item.image;
              return (
                <article class:list={["post-card", { "post-card--photo": isPhoto }]}>
                  <div class="post-card-top">
                    <div class="post-card-meta">{displayDate(item.date)}</div>
                  </div>
                  {isPhoto && (
                    <a class="post-card-image" href={item.href} aria-label={item.title}>
                      <img
                        src={photoSrc}
                        alt={item.imageAlt || item.title}
                        loading="lazy"
                        decoding="async"
                        width={item.width}
                        height={item.height}
                      />
                      {(item.imageCount || 0) > 1 && (
                        <span class="photo-card-count">{item.imageCount} images</span>
                      )}
                    </a>
                  )}
                  <h2><a href={item.href}>{item.title}</a></h2>
                  {item.summary && <p class="post-summary">{item.summary}</p>}
                  {item.tags.length > 0 && <TagList tags={item.tags} />}
                </article>
              );
            })}
          </div>
        </section>
      )}
      <KnowledgeGraph data={shellPage.graphData || emptyGraph} variant="home" />
      {recentItems.length > 0 && (
        <section class="home-section home-feed">
          <div class="home-section-head">
            <h2>Recent</h2>
            <span class="sidebar-more">
              <a href={contentHref("/archives/")}>
                All archives →
              </a>
            </span>
          </div>
          <div class="post-list">
            {recentItems.map((item: any) => {
              const isPhoto = item.section === "fotografia" && Boolean(item.thumbnail || item.image);
              const photoSrc = item.thumbnail || item.image;
              return (
                <article class:list={["post-card", { "post-card--photo": isPhoto }]}>
                  <div class="post-card-top">
                    <div class="post-card-meta">{displayDate(item.date)}</div>
                    {item.section && (
                      <span class={`archive-badge archive-badge--${item.section}`}>
                        {badgeLabel(item.section)}
                      </span>
                    )}
                  </div>
                  {isPhoto && (
                    <a class="post-card-image" href={item.href} aria-label={item.title}>
                      <img
                        src={photoSrc}
                        alt={item.imageAlt || item.title}
                        loading="lazy"
                        decoding="async"
                        width={item.width}
                        height={item.height}
                      />
                      {(item.imageCount || 0) > 1 && (
                        <span class="photo-card-count">{item.imageCount} images</span>
                      )}
                    </a>
                  )}
                  <h2><a href={item.href}>{item.title}</a></h2>
                  {item.summary && <p class="post-summary">{item.summary}</p>}
                  {item.tags.length > 0 && <TagList tags={item.tags} />}
                </article>
              );
            })}
          </div>
        </section>
      )}
    </>
  )}

  {model.layout === "single" && (page.section === "proyectos-profesionales" ? (
    <ProjectOverview page={page} authorMode={authorMode} bodyHtml={removeLegacyLinkSpacing(page.bodyHtml || "")} />
  ) : (
    <Single
      title={title}
      date={page.date}
      section={page.section}
      summary={page.summary}
      tags={tagsFor(page)}
      bodyHtml={removeLegacyLinkSpacing(page.bodyHtml || "")}
      bodyMarkdown={page.bodyMarkdown || ""}
      sourcePath={page.sourcePath}
      slug={frontMatter.slug}
      permalink={page.path}
      image={frontMatter.image}
      imageAlt={frontMatter.image_alt}
      caption={frontMatter.caption}
      images={photoImages(frontMatter.images)}
      titleInBody={/^\s*#\s+\S/m.test(page.bodyMarkdown || "")}
      authorMode={authorMode}
      backlinks={(model.backlinks || []).map((backlink: any) => ({
        title: backlink.title,
        href: contentHref(backlink.path),
        date: backlink.date,
      }))}
    />
  ))}

  {model.layout === "list" && (page.section === "proyectos-profesionales" ? (
    <ProjectCatalog title={title} description={description} authorMode={authorMode}
      notebook={page.sourcePath.replace(/\/_index\.md$/, "")} projects={model.items} />
  ) : (
    <List
      title={title}
      description={description}
      items={items}
      authorMode={authorMode}
      notebook={page.sourcePath?.replace(/\/_index\.md$/, "")}
      editorial={page.section === "posts" || page.section === "proyectos-profesionales"}
      projects={page.section === "proyectos-profesionales"}
    />
  ))}

  {model.layout === "quotes" && (
    <Quotes
      title={title}
      description={description}
      authorMode={authorMode}
      notebook={page.sourcePath?.replace(/\/_index\.md$/, "")}
      items={(model.items || []).map((document: any) => ({
        ...listItem(document),
        quotes: Array.isArray(document.frontMatter?.quotes) ? document.frontMatter.quotes : [],
      }))}
    />
  )}

  {model.layout === "books" && (
    <Books
      title={title}
      description={description}
      authorMode={authorMode}
      books={(model.items || []).map((book: any) => ({
        ...listItem(book),
        sourcePath: book.sourcePath,
        author: book.frontMatter?.book_author,
        image: book.frontMatter?.image,
        imageAlt: book.frontMatter?.image_alt,
        status: book.frontMatter?.book_status,
        progress: book.frontMatter?.book_progress,
        rating: book.frontMatter?.rating,
        review: bookReview(book.bodyMarkdown),
      }))}
    />
  )}

  {authorMode && (layout === "books" || (model.layout === "single" && isBookContentPath(page.sourcePath))) && (
    <ReadingForm kind="book" />
  )}
  {authorMode && layout === "books" && <ReadingForm kind="new-book" />}
  {authorMode && layout === "quotes" && <ReadingForm kind="quote" />}

  {model.layout === "photography" && (
    <Photography
      title={title}
      description={description}
      authorMode={authorMode}
      photos={(model.items || []).map((photo: any) => {
        const gallery = photoImages(photo.frontMatter?.images);
        const first = gallery[0];
        return {
          ...listItem(photo),
          image: photo.frontMatter?.image || first?.src,
          thumbnail: photo.frontMatter?.thumbnail || photo.frontMatter?.thumb,
          imageAlt: photo.frontMatter?.image_alt || first?.alt,
          caption: photo.frontMatter?.caption,
          imageCount: gallery.length,
          width: photo.frontMatter?.width,
          height: photo.frontMatter?.height,
        };
      })}
    />
  )}

  {model.layout === "guestbook" && (
    <Guestbook
      title={title}
      description={description}
      entries={(model.entries || []).map((entry: any) => ({
        id: entry.id,
        name: entry.name,
        site: entry.site,
        message: entry.message,
        createdAt: entry.created_at,
      }))}
    />
  )}

  {model.layout === "archives" && <Archives title={title} items={items} />}

  {model.layout === "tags" && (
    <Tags
      title={title}
      terms={(model.tags || []).map((tag: any) => ({
        label: tag.label,
        slug: tag.slug,
        count: Number(tag.count),
        href: tagHref(tag.slug),
      }))}
    />
  )}

  {model.layout === "tag" && (
    <List title={title} items={(model.items || []).map(taxonomyItem)} showTags={false} />
  )}

  {model.layout === "not-found" && <NotFound homeHref={contentHref("/")} />}
</SiteLayout>
